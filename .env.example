# ---- Core ----
# Public address people open in the browser (no trailing slash)
APP_URL=https://ops.example.mil.ng
NODE_ENV=production
TZ=Africa/Lagos

# ---- Database ----
POSTGRES_USER=flightops
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=flight_ops
DATABASE_URL=postgresql://flightops:change-me-long-random@db:5432/flight_ops

# ---- Security (generate each with: openssl rand -base64 48) ----
JWT_SECRET=replace-with-48-random-bytes
# Used to encrypt two-step sign-in secrets at rest
DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
IDLE_TIMEOUT_MINUTES=30

# ---- Email (Gmail: use an App Password, not the account password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=unit.account@gmail.com
SMTP_PASS=gmail-app-password
MAIL_FROM="Flight Ops <unit.account@gmail.com>"

# ---- Phone notifications ----
# Web Push (installed web app on Android and iPhone). Create once with:  npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:unit.account@gmail.com
# Firebase Cloud Messaging (Play Store / App Store app). Firebase console → Project settings →
# Service accounts → Generate new private key; then base64 the JSON file (see the go-live guide).
FCM_SERVICE_ACCOUNT_BASE64=
# FCM messages pass through Google readably, so by default they say only "You have a new item".
PUSH_FCM_SHOW_TITLES=false

# ---- File storage (MinIO on a unit server, or AWS S3) ----
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=flight-ops
S3_ACCESS_KEY=minio-access-key
S3_SECRET_KEY=minio-secret-key-long
S3_FORCE_PATH_STYLE=true

# ---- First administrator (used once by the seed script) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThis!2026
SEED_ADMIN_NAF=SVC/0000
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_RANK=Squadron Leader
SEED_ADMIN_PHONE=+2340000000000

# ---- Privacy ----
# Address shown on the privacy policy and account-deletion pages
PRIVACY_EMAIL=privacy@example.com

# ---- Caddy (HTTPS) ----
# The domain Caddy requests a certificate for. Use "localhost" or an IP with "tls internal" on a closed network.
SITE_ADDRESS=ops.example.mil.ng
